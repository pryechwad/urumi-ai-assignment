# Local development only (npm run dev). In Kubernetes these come from the Helm chart's
# ConfigMap and Secrets; never commit real values.

# --- gateway (apps/gateway)
DATABASE_URL=postgres://gateway:change-me@localhost:5432/gateway
# base64 of 32 random bytes: openssl rand -base64 32
CREDENTIALS_KEY=
PUBLIC_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=pryechwad@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Hosts allowed to resolve to private addresses (local upstreams during development)
UPSTREAM_PRIVATE_HOSTS=localhost,127.0.0.1
# JSON list of servers registered on first start; credentials are read from the named env vars
SEED_SERVERS=[{"key":"inventory","slug":"inventory","name":"Inventory","url":"http://localhost:3102/mcp","authType":"bearer","credentialEnv":"SEED_INVENTORY_TOKEN"}]
SEED_INVENTORY_TOKEN=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
STORE_TIMEZONE=Asia/Kolkata

# --- woo-mcp (apps/woo-mcp)
WOO_BASE_URL=http://localhost:8081
WOO_HOME_URL=http://localhost:8081
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
MCP_AUTH_TOKEN=
